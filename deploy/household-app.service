[Unit]
Description=household-app

[Service]
WorkingDirectory=%h/dev/projects/household-app
ExecStart=%h/dev/projects/household-app/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
# The database and raw exports are financial data; keep them readable by this user only.
UMask=0077
Restart=on-failure

[Install]
WantedBy=default.target
